# Copy this file to .env and fill in your key to enable live LLM mode.
# Without it, the app runs fully offline from cached fixtures (demo-safe).

# 1 = Blue/Red/Arbiter drafts call the LLM live; 0 = use cache/fallbacks
SPLITHORIZON_LIVE=1

# Your OpenAI API key (https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=sk-...
