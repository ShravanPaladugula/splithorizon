# Copy to .env and fill in your key. .env is gitignored — never commit it.
#
# Every agent (Blue, Red, arbiter, intake) is a live model call. There is no
# offline mode: without a working key the app reports an error rather than
# inventing an answer.

# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional model overrides. The defaults split work across two per-model daily
# token budgets: high-volume Blue/Red drafts on 20b, the arbiter memo on 120b.
# llama-3.1-8b-instant is unusable here — it cannot hold a strict JSON schema.
# SPLITHORIZON_MODEL=groq/openai/gpt-oss-20b
# SPLITHORIZON_LEAD_MODEL=groq/openai/gpt-oss-120b
